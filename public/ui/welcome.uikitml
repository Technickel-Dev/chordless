<!--
  Panel, Button, ButtonIcon and ButtonLabel come from the bundled Horizon kit;
  every other capitalised tag is a bundled Lucide icon. The :dark styles apply
  because iwsdk.config.json prefers the dark color scheme.

  The panel is icon-first and has three parts that PanelSystem shows and hides:
  - the bar (always there): menu-open / menu-close and hint-toggle;
  - #menu: instrument tiles, the guitar tone, volume, reset, scene and XR controls;
  - #hint: one strip of pictograms per instrument (hint-guitar, hint-bass, ...).
  Choosing an instrument folds the menu away and shows that instrument's hint
  for a few seconds, so only the bar is left while playing.
-->
<style>
  .panel-root {
    flex-direction: column;
    align-items: stretch;
  }

  .bar {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
  }

  .icon-button {
    width: 64px;
    height: 64px;
    justify-content: center;
    padding-left: 0px;
    padding-right: 0px;
  }

  .title {
    flex-grow: 1;
    justify-content: center;
    color: #185fa5;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 3px;
  }

  .title:dark {
    color: #85b7eb;
  }

  .menu {
    flex-direction: column;
    gap: 14px;
    width: 640px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
  }

  .tiles {
    flex-direction: row;
    gap: 10px;
  }

  .tile {
    flex-direction: column;
    width: 91px;
    height: 104px;
    gap: 6px;
    justify-content: center;
    align-items: center;
    padding-left: 0px;
    padding-right: 0px;
  }

  .tile-label {
    font-size: 15px;
  }

  .controls {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }

  .spacer {
    flex-grow: 1;
  }

  .group {
    flex-direction: row;
    gap: 6px;
  }

  .scene-name {
    flex-grow: 1;
    justify-content: center;
    color: #1c1d20;
    font-size: 20px;
    font-weight: 700;
  }

  .scene-name:dark {
    color: #85b7eb;
  }

  .xr {
    justify-content: center;
  }

  .hint {
    flex-direction: column;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
  }

  .steps {
    flex-direction: row;
    gap: 14px;
    justify-content: center;
  }

  .step {
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 150px;
  }

  .step-icon {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    justify-content: center;
    align-items: center;
    background-color: #85b7eb;
  }

  .glyph {
    width: 44px;
    height: 44px;
    color: #042c53;
  }

  .step-text {
    color: #1c1d20;
    font-size: 19px;
    font-weight: 700;
    text-align: center;
  }

  .step-text:dark {
    color: #fafaf7;
  }

  .side {
    padding-top: 3px;
    padding-right: 10px;
    padding-bottom: 3px;
    padding-left: 10px;
    border-radius: 10px;
    background-color: #e4e5e9;
    color: #3a3b40;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .side:dark {
    background-color: #3a3b40;
    color: #dddfe3;
  }
</style>
<Panel class="panel-root">
  <div class="bar">
    <Button id="menu-open" variant="secondary" class="icon-button">
      <ButtonIcon><Menu></Menu></ButtonIcon>
    </Button>
    <Button id="menu-close" variant="secondary" class="icon-button">
      <ButtonIcon><X></X></ButtonIcon>
    </Button>
    <div id="title" class="title">CHORDLESS</div>
    <Button id="hint-toggle" variant="secondary" class="icon-button">
      <ButtonIcon><CircleHelp></CircleHelp></ButtonIcon>
    </Button>
  </div>

  <div id="menu" class="menu">
    <div class="tiles">
      <Button id="instrument-guitar" variant="primary" class="tile">
        <ButtonIcon><Guitar></Guitar></ButtonIcon>
        <ButtonLabel class="tile-label">Guitar</ButtonLabel>
      </Button>
      <Button id="instrument-bass" variant="secondary" class="tile">
        <ButtonIcon><Speaker></Speaker></ButtonIcon>
        <ButtonLabel class="tile-label">Bass</ButtonLabel>
      </Button>
      <Button id="instrument-violin" variant="secondary" class="tile">
        <ButtonIcon><Music2></Music2></ButtonIcon>
        <ButtonLabel class="tile-label">Violin</ButtonLabel>
      </Button>
      <Button id="instrument-cello" variant="secondary" class="tile">
        <ButtonIcon><Music4></Music4></ButtonIcon>
        <ButtonLabel class="tile-label">Cello</ButtonLabel>
      </Button>
      <Button id="instrument-piano" variant="secondary" class="tile">
        <ButtonIcon><Piano></Piano></ButtonIcon>
        <ButtonLabel class="tile-label">Piano</ButtonLabel>
      </Button>
      <Button id="instrument-drums" variant="secondary" class="tile">
        <ButtonIcon><Drum></Drum></ButtonIcon>
        <ButtonLabel class="tile-label">Drums</ButtonLabel>
      </Button>
    </div>
    <div class="tiles">
      <Button id="instrument-cymbals" variant="secondary" class="tile">
        <ButtonIcon><Disc3></Disc3></ButtonIcon>
        <ButtonLabel class="tile-label">Cymbals</ButtonLabel>
      </Button>
      <Button id="instrument-triangle" variant="secondary" class="tile">
        <ButtonIcon><Triangle></Triangle></ButtonIcon>
        <ButtonLabel class="tile-label">Triangle</ButtonLabel>
      </Button>
      <Button id="instrument-trumpet" variant="secondary" class="tile">
        <ButtonIcon><Megaphone></Megaphone></ButtonIcon>
        <ButtonLabel class="tile-label">Trumpet</ButtonLabel>
      </Button>
      <Button id="instrument-trombone" variant="secondary" class="tile">
        <ButtonIcon><MoveHorizontal></MoveHorizontal></ButtonIcon>
        <ButtonLabel class="tile-label">Trombone</ButtonLabel>
      </Button>
      <Button id="instrument-horn" variant="secondary" class="tile">
        <ButtonIcon><Shell></Shell></ButtonIcon>
        <ButtonLabel class="tile-label">Horn</ButtonLabel>
      </Button>
    </div>

    <div class="controls">
      <div class="group">
        <Button id="volume-down" variant="secondary" class="icon-button">
          <ButtonIcon><Volume1></Volume1></ButtonIcon>
        </Button>
        <Button id="volume-up" variant="secondary" class="icon-button">
          <ButtonIcon><Volume2></Volume2></ButtonIcon>
        </Button>
      </div>
      <div id="tone-group" class="group">
        <Button id="tone-clean" variant="primary" class="icon-button">
          <ButtonIcon><AudioWaveform></AudioWaveform></ButtonIcon>
        </Button>
        <Button id="tone-drive" variant="secondary" class="icon-button">
          <ButtonIcon><Zap></Zap></ButtonIcon>
        </Button>
      </div>
      <div class="spacer"></div>
      <Button id="reset-guitar" variant="secondary" class="icon-button">
        <ButtonIcon><LocateFixed></LocateFixed></ButtonIcon>
      </Button>
    </div>

    <div class="controls">
      <Button id="scene-prev" variant="secondary" class="icon-button">
        <ButtonIcon><ChevronLeft></ChevronLeft></ButtonIcon>
      </Button>
      <div id="scene-name" class="scene-name">Theatre</div>
      <Button id="scene-next" variant="secondary" class="icon-button">
        <ButtonIcon><ChevronRight></ChevronRight></ButtonIcon>
      </Button>
    </div>

    <Button id="xr-button" class="xr">
      <ButtonIcon><RectangleGoggles></RectangleGoggles></ButtonIcon>
      <ButtonLabel>Enter XR</ButtonLabel>
    </Button>
    <Button id="exit-button" class="xr" style="display: none">
      <ButtonIcon><LogIn></LogIn></ButtonIcon>
      <ButtonLabel>Exit</ButtonLabel>
    </Button>
  </div>

  <div id="hint" class="hint" style="display: none">
    <div id="hint-guitar" class="steps">
      <div class="step">
        <div class="step-icon"><Hand class="glyph"></Hand></div>
        <div class="step-text">Press frets</div>
        <div class="side">LEFT</div>
      </div>
      <div class="step">
        <div class="step-icon"><AudioWaveform class="glyph"></AudioWaveform></div>
        <div class="step-text">Strum</div>
        <div class="side">RIGHT</div>
      </div>
      <div class="step">
        <div class="step-icon"><Grab class="glyph"></Grab></div>
        <div class="step-text">Pinch to move</div>
        <div class="side">BOTH</div>
      </div>
    </div>
    <div id="hint-bass" class="steps">
      <div class="step">
        <div class="step-icon"><Hand class="glyph"></Hand></div>
        <div class="step-text">Press frets</div>
        <div class="side">LEFT</div>
      </div>
      <div class="step">
        <div class="step-icon"><Pointer class="glyph"></Pointer></div>
        <div class="step-text">Pluck</div>
        <div class="side">RIGHT</div>
      </div>
      <div class="step">
        <div class="step-icon"><Grab class="glyph"></Grab></div>
        <div class="step-text">Pinch to move</div>
        <div class="side">BOTH</div>
      </div>
    </div>
    <div id="hint-violin" class="steps">
      <div class="step">
        <div class="step-icon"><Hand class="glyph"></Hand></div>
        <div class="step-text">Press strings</div>
        <div class="side">LEFT</div>
      </div>
      <div class="step">
        <div class="step-icon"><MoveHorizontal class="glyph"></MoveHorizontal></div>
        <div class="step-text">Bow</div>
        <div class="side">RIGHT</div>
      </div>
      <div class="step">
        <div class="step-icon"><RotateCw class="glyph"></RotateCw></div>
        <div class="step-text">Tilt for string</div>
        <div class="side">RIGHT</div>
      </div>
    </div>
    <div id="hint-cello" class="steps">
      <div class="step">
        <div class="step-icon"><Hand class="glyph"></Hand></div>
        <div class="step-text">Press strings</div>
        <div class="side">LEFT</div>
      </div>
      <div class="step">
        <div class="step-icon"><MoveHorizontal class="glyph"></MoveHorizontal></div>
        <div class="step-text">Bow</div>
        <div class="side">RIGHT</div>
      </div>
      <div class="step">
        <div class="step-icon"><RotateCw class="glyph"></RotateCw></div>
        <div class="step-text">Tilt for string</div>
        <div class="side">RIGHT</div>
      </div>
    </div>
    <div id="hint-piano" class="steps">
      <div class="step">
        <div class="step-icon"><Pointer class="glyph"></Pointer></div>
        <div class="step-text">Press keys</div>
        <div class="side">ANY FINGER</div>
      </div>
      <div class="step">
        <div class="step-icon"><Gauge class="glyph"></Gauge></div>
        <div class="step-text">Faster is louder</div>
        <div class="side">ANY FINGER</div>
      </div>
    </div>
    <div id="hint-drums" class="steps">
      <div class="step">
        <div class="step-icon"><Grab class="glyph"></Grab></div>
        <div class="step-text">Make fists</div>
        <div class="side">BOTH</div>
      </div>
      <div class="step">
        <div class="step-icon"><ArrowDown class="glyph"></ArrowDown></div>
        <div class="step-text">Hit drums</div>
        <div class="side">BOTH</div>
      </div>
      <div class="step">
        <div class="step-icon"><Footprints class="glyph"></Footprints></div>
        <div class="step-text">Kick pad</div>
        <div class="side">RIGHT KNEE</div>
      </div>
    </div>
    <div id="hint-cymbals" class="steps">
      <div class="step">
        <div class="step-icon"><ArrowLeftRight class="glyph"></ArrowLeftRight></div>
        <div class="step-text">Clash</div>
        <div class="side">BOTH</div>
      </div>
      <div class="step">
        <div class="step-icon"><VolumeX class="glyph"></VolumeX></div>
        <div class="step-text">Hold to stop</div>
        <div class="side">BOTH</div>
      </div>
    </div>
    <div id="hint-triangle" class="steps">
      <div class="step">
        <div class="step-icon"><Grab class="glyph"></Grab></div>
        <div class="step-text">Pinch clip</div>
        <div class="side">LEFT</div>
      </div>
      <div class="step">
        <div class="step-icon"><Hammer class="glyph"></Hammer></div>
        <div class="step-text">Strike</div>
        <div class="side">RIGHT FIST</div>
      </div>
      <div class="step">
        <div class="step-icon"><VolumeX class="glyph"></VolumeX></div>
        <div class="step-text">Touch to stop</div>
        <div class="side">LEFT</div>
      </div>
    </div>
    <div id="hint-trumpet" class="steps">
      <div class="step">
        <div class="step-icon"><Pointer class="glyph"></Pointer></div>
        <div class="step-text">Valves</div>
        <div class="side">RIGHT</div>
      </div>
      <div class="step">
        <div class="step-icon"><Wind class="glyph"></Wind></div>
        <div class="step-text">Pinch to blow</div>
        <div class="side">LEFT</div>
      </div>
      <div class="step">
        <div class="step-icon"><ArrowUp class="glyph"></ArrowUp></div>
        <div class="step-text">Tilt up = higher</div>
        <div class="side">BELL</div>
      </div>
    </div>
    <div id="hint-trombone" class="steps">
      <div class="step">
        <div class="step-icon"><Wind class="glyph"></Wind></div>
        <div class="step-text">Pinch to blow</div>
        <div class="side">LEFT</div>
      </div>
      <div class="step">
        <div class="step-icon"><MoveHorizontal class="glyph"></MoveHorizontal></div>
        <div class="step-text">Slide</div>
        <div class="side">RIGHT</div>
      </div>
      <div class="step">
        <div class="step-icon"><ArrowUp class="glyph"></ArrowUp></div>
        <div class="step-text">Tilt up = higher</div>
        <div class="side">BELL</div>
      </div>
    </div>
    <div id="hint-horn" class="steps">
      <div class="step">
        <div class="step-icon"><Pointer class="glyph"></Pointer></div>
        <div class="step-text">Valves</div>
        <div class="side">LEFT</div>
      </div>
      <div class="step">
        <div class="step-icon"><Wind class="glyph"></Wind></div>
        <div class="step-text">Pinch in bell</div>
        <div class="side">RIGHT</div>
      </div>
      <div class="step">
        <div class="step-icon"><ArrowUp class="glyph"></ArrowUp></div>
        <div class="step-text">Tilt up = higher</div>
        <div class="side">BELL</div>
      </div>
    </div>
  </div>
</Panel>

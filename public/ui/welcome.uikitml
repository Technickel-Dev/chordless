<!--
  Panel, Button and ButtonLabel come from the bundled Horizon kit.
  RectangleGoggles and LogIn are bundled Lucide icon components. The :dark
  styles apply because iwsdk.config.json prefers the dark color scheme.
  PanelSystem wires the instrument, tone, volume and reset ids below to the
  AirGuitar, AirViolin, AirCello, AirCymbals, AirTriangle, AirPiano, AirDrums and
  AirTrumpet components, and scene-prev / scene-next to the level list in
  src/scene-list.ts.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 640px;
  }

  .panel-content {
    flex-direction: column;
    gap: 6px;
    padding-top: 22px;
    padding-right: 22px;
    padding-bottom: 12px;
    padding-left: 22px;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #f5d90a;
  }

  .heading {
    color: #1c1d20;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.2;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .body {
    color: #3a3b40;
    font-size: 18px;
    line-height: 1.35;
  }

  .body:dark {
    color: #dddfe3;
  }

  .row {
    flex-direction: row;
    gap: 10px;
    padding-right: 22px;
    padding-bottom: 14px;
    padding-left: 22px;
  }

  .scene-row {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding-right: 22px;
    padding-bottom: 14px;
    padding-left: 22px;
  }

  .scene-name {
    flex-grow: 1;
    justify-content: center;
    color: #1c1d20;
    font-size: 20px;
    font-weight: 700;
  }

  .scene-name:dark {
    color: #f5d90a;
  }

  .button {
    justify-content: flex-start;
    margin-left: 22px;
    margin-right: 22px;
    margin-bottom: 22px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">CHORDLESS - AIR INSTRUMENTS</div>
    <div class="heading">Play with your hands</div>
    <div class="body">Put the controllers down. The guitar hangs in front of you.</div>
    <div class="body">Left fingertips press the strings between the frets.</div>
    <div class="body">Right index fingertip plucks: sweep to strum, flick for one string.</div>
    <div class="body">Lift above the strings to move back silently; rest on one to mute it.</div>
    <div class="body">Pinch both hands for a second to move the guitar to them.</div>
    <div class="body">Violin and cello: stop the strings anywhere on the fingerboard. The bow is in your right hand: draw it across near the bridge, tilt it to change string.</div>
    <div class="body">Cymbals: one in each hand. Clash them together, faster for louder; press them together or to your chest to stop the ringing.</div>
    <div class="body">Triangle: pinch its clip in your left hand; strike it with the beater in your right fist. Touch it with your free fingers, or rest the beater on it, to stop it.</div>
    <div class="body">Piano: it stands in front of you. Press the keys with any fingertip; faster is louder.</div>
    <div class="body">Drums: a stick in each fist. Bring the tips down on the heads and cymbals; hit the snare's rim for a rimshot, the hi-hat's edge to open it, the ride's bell for its ping. The round pad by your right knee is the kick.</div>
    <div class="body">Trumpet: right fingers press the valves; hold it out to your lips and tilt the bell up for higher notes. Pinch your left hand to blow; cup it over the bell to mute.</div>
  </div>
  <div class="row">
    <Button id="instrument-guitar" variant="primary">
      <ButtonLabel>Guitar</ButtonLabel>
    </Button>
    <Button id="instrument-violin" variant="secondary">
      <ButtonLabel>Violin</ButtonLabel>
    </Button>
    <Button id="instrument-cello" variant="secondary">
      <ButtonLabel>Cello</ButtonLabel>
    </Button>
    <Button id="instrument-cymbals" variant="secondary">
      <ButtonLabel>Cymbals</ButtonLabel>
    </Button>
    <Button id="instrument-triangle" variant="secondary">
      <ButtonLabel>Triangle</ButtonLabel>
    </Button>
    <Button id="instrument-piano" variant="secondary">
      <ButtonLabel>Piano</ButtonLabel>
    </Button>
    <Button id="instrument-drums" variant="secondary">
      <ButtonLabel>Drums</ButtonLabel>
    </Button>
    <Button id="instrument-trumpet" variant="secondary">
      <ButtonLabel>Trumpet</ButtonLabel>
    </Button>
  </div>
  <div class="row">
    <Button id="tone-clean" variant="primary">
      <ButtonLabel>Clean</ButtonLabel>
    </Button>
    <Button id="tone-drive" variant="secondary">
      <ButtonLabel>Overdrive</ButtonLabel>
    </Button>
    <Button id="volume-down" variant="secondary">
      <ButtonLabel>Vol -</ButtonLabel>
    </Button>
    <Button id="volume-up" variant="secondary">
      <ButtonLabel>Vol +</ButtonLabel>
    </Button>
    <Button id="reset-guitar" variant="secondary">
      <ButtonLabel>Reset position</ButtonLabel>
    </Button>
  </div>
  <div class="scene-row">
    <Button id="scene-prev" variant="secondary">
      <ButtonLabel>Prev scene</ButtonLabel>
    </Button>
    <div id="scene-name" class="scene-name">Theatre</div>
    <Button id="scene-next" variant="secondary">
      <ButtonLabel>Next scene</ButtonLabel>
    </Button>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
